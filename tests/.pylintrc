[MAIN]
py-version=3.10

[FORMAT]
max-line-length=100

[BASIC]
good-names=i,j,k,_,io,ex,e

[MESSAGES CONTROL]
# Test idioms: pytest fixtures shadow names and are often unused by design.
disable=
    missing-function-docstring,
    missing-class-docstring,
    redefined-outer-name,
    unused-argument,
    import-outside-toplevel,
    too-few-public-methods,
    duplicate-code
