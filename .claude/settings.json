{
  "permissions": {
    "deny": [
      "Bash(git)",
      "Bash(git *)",
      "Bash(gh)",
      "Bash(gh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git.sh",
            "onFailure": "block",
            "statusMessage": "Checking for git/gh usage"
          }
        ]
      }
    ]
  }
}
